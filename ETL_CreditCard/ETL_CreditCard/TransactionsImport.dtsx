      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Calculate Checksum for temp"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E597D56B-D961-4966-946C-4CF266A757E2}"
          SQLTask:SqlStatementSource="UPDATE stage.transactions_processed&#xA;SET dw_row_checksum = CONVERT(&#xA; VARCHAR(64),&#xA; HASHBYTES('MD5', CONCAT(&#xA;  ISNULL(stage.transactions_processed.credit_card_number, ''),&#xA;  ISNULL(stage.transactions_processed.trans_num, '')&#xA; )&#xA;), 2&#xA;)&#xA;;"
          SQLTask:CodePage="65001" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
