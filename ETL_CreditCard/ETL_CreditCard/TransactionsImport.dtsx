      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E597D56B-D961-4966-946C-4CF266A757E2}"
          SQLTask:SqlStatementSource="UPDATE stage.transactions&#xA;SET dw_row_checksum = CONVERT(&#xA;&#x9;VARCHAR(64),&#xA;&#x9;HASHBYTES('MD5', CONCAT(&#xA;&#x9;&#x9;ISNULL(stage.transactions.cc_num, ''),&#xA;&#x9;&#x9;ISNULL(stage.transactions.trans_num, '')&#xA;&#x9;)&#xA;), 2&#xA;)&#xA;;"
          SQLTask:CodePage="65001" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
